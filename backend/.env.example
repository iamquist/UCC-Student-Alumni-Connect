# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB (Docker)
MONGODB_URI=mongodb://localhost:27017/unialum
MONGODB_DB_NAME=unialum

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis (Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=UniAlum <noreply@unialum.com>

# SMS (optional - Twilio or Africa's Talking)
SMS_PROVIDER=africas_talking
SMS_API_KEY=your-sms-api-key
SMS_USERNAME=your-sms-username
SMS_SENDER_ID=UniAlum

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin
ADMIN_EMAIL=admin@unialum.com
ADMIN_PASSWORD=Admin@123456

# Client URL (for email links)
CLIENT_URL=http://localhost:3000
